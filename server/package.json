{
  "name": "@collected/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "sync": "tsx src/cli.ts sync",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@collected/core": "workspace:*",
    "@collected/shared": "workspace:*",
    "@googleapis/calendar": "^20.1.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "cheerio": "^1.2.0",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fetch-cookie": "^3.2.0",
    "google-auth-library": "^11.3.2",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "node-ical": "^0.27.3",
    "pino": "^10.4.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
