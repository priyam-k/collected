{
  "name": "collected-cli",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "Command-line client for collected, the self-hosted student dashboard: read your agenda, courses, grades and announcements, make small edits, browse Canvas read-only, and sync course files into local folders.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyam-k/collected.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/priyam-k/collected/tree/main/agent#readme",
  "bugs": {
    "url": "https://github.com/priyam-k/collected/issues"
  },
  "keywords": [
    "collected",
    "canvas",
    "gradescope",
    "student",
    "cli"
  ],
  "bin": {
    "collected": "./dist/cli.js",
    "collected-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@collected/shared": "workspace:*",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
