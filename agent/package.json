{
  "name": "collected-cli",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "Command-line client for collected, the self-hosted student dashboard: read your agenda, courses, grades and announcements, make small edits, browse Canvas read-only, and sync course files into local folders. Runs against your server, or on its own against a database on this machine (local mode).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyam-k/collected.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/priyam-k/collected/tree/main/agent#readme",
  "bugs": {
    "url": "https://github.com/priyam-k/collected/issues"
  },
  "keywords": [
    "collected",
    "canvas",
    "gradescope",
    "student",
    "cli"
  ],
  "bin": {
    "collected": "./dist/cli.js",
    "collected-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "fetch-cookie": "^3.2.0",
    "google-auth-library": "^11.3.1",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "node-ical": "^0.27.3",
    "pino": "^10.4.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@collected/core": "workspace:*",
    "@collected/server": "workspace:*",
    "@collected/shared": "workspace:*",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
