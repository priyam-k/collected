# --- server ---
PORT=3000
DATA_DIR=./data
# Encrypts stored credentials. Leave EMPTY to auto-create data/.secret_key next to the database (recommended);
# or set 32 random bytes as hex (openssl rand -hex 32). Changing or losing the key means re-entering every credential.
SECRET_KEY=
# Local dev only. Leave false anywhere reachable from the internet; Cloudflare Access is the login wall.
# With NODE_ENV=production the server refuses to start with AUTH_DISABLED=true unless AUTH_DISABLED_ACKNOWLEDGED=true
# is also set, because every stored credential would be readable by anyone who reaches the port.
AUTH_DISABLED=false
# From the Cloudflare Access application (Phase 2 in artifacts/SETUP.md)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Shared secret for `collected connect canvas` (the agent CLI). Accepted only on POST /api/sources/canvas/cookie, nothing else.
# At least 32 characters: openssl rand -hex 32
LOCAL_HELPER_KEY=
# Google Cloud OAuth client (Phase 1 in artifacts/SETUP.md). Used for sign-in (identity only) and, separately, Calendar.
# Redirect URIs to register: <PUBLIC_URL>/api/auth/google/callback and <PUBLIC_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Todoist app (https://developer.todoist.com/appconsole.html) so Settings → Sources → Todoist gets a "Connect Todoist"
# button instead of a pasted API token. OAuth redirect URL to register: <PUBLIC_URL>/api/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Who may sign in, comma-separated. Leave empty and the first person to sign in claims this instance.
ALLOWED_EMAILS=
# Where the browser reaches the app. Dev: the Vite server. Prod: https://collected.example.com
PUBLIC_URL=http://localhost:5173
SCHEDULER_DISABLED=false
SEED_CONFIG_PATH=../artifacts/seed-config.json
TZ=America/New_York
LOG_LEVEL=info
# --- update check (self-host) ---
# Every 6 hours the server asks GitHub how far upstream main is ahead of the running commit and shows a banner with the
# commands to pull it. Nothing is sent but the commit sha. Set true to switch it off entirely.
UPDATE_CHECK_DISABLED=false
# The repository to compare against. Change it only if you run your own fork.
UPSTREAM_REPO=priyam-k/collected
# Only if UPSTREAM_REPO is private: a fine-grained GitHub token with Contents: read on that repository
UPDATE_CHECK_TOKEN=
# The running commit. The image sets it at build time; leave empty (dev reads it from git).
COLLECTED_COMMIT=
