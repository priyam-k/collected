# --- server ---
PORT=3000
DATA_DIR=./data
# Encrypts stored credentials. Leave EMPTY to auto-create data/.secret_key next to the database (recommended);
# or set 32 random bytes as hex (openssl rand -hex 32). Changing or losing the key means re-entering every credential.
SECRET_KEY=
# Local dev only. Leave false anywhere reachable from the internet; Cloudflare Access is the login wall.
# With NODE_ENV=production the server refuses to start with AUTH_DISABLED=true unless AUTH_DISABLED_ACKNOWLEDGED=true
# is also set, because every stored credential would be readable by anyone who reaches the port.
AUTH_DISABLED=false
# From the Cloudflare Access application (Phase 2 in artifacts/SETUP.md)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Shared secret for `collected connect canvas` (the agent CLI). Accepted only on POST /api/sources/canvas/cookie, nothing else.
# At least 32 characters: openssl rand -hex 32
LOCAL_HELPER_KEY=
# Google Cloud OAuth client (Phase 1 in artifacts/SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser reaches the app. Dev: the Vite server. Prod: https://collected.priyamkabra.com
PUBLIC_URL=http://localhost:5173
SCHEDULER_DISABLED=false
SEED_CONFIG_PATH=../artifacts/seed-config.json
TZ=America/New_York
LOG_LEVEL=info
