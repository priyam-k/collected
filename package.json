{
  "name": "collected",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sync": "pnpm --filter server sync",
    "cli": "pnpm --filter server cli",
    "db:generate": "pnpm --filter server db:generate",
    "canvas-cookie": "python3 local/canvas_cookie.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3"
  }
}
